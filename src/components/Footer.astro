---
import DnsBadge from './DnsBadge.astro';
---
<footer class="mt-24 border-t border-steel-700/60 bg-steel-900">
  <div class="container-wide py-12 grid gap-10 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="flex items-center gap-3">
        <img src="/logos/logo-icon.png" alt="" class="h-9 w-9" />
        <span class="text-sm font-bold uppercase tracking-[0.18em] text-white">Blue Collar Labs</span>
      </div>
      <p class="mt-4 max-w-md text-sm text-steel-300">
        A 501(c)(3) nonprofit building AI tools <em>for</em> tradesmen, teaching tradesmen <em>with</em> AI, and defending tradesmen <em>from</em> AI.
      </p>
      <div class="mt-5 flex items-center gap-3">
        <a
          href="https://www.instagram.com/bluecollar_labs"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Blue Collar Labs on Instagram"
          class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-steel-700/60 text-steel-300 transition hover:border-volt-500 hover:text-volt-500"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
            <path d="M12 2.2c3.2 0 3.6 0 4.8.07 1.2.05 1.8.25 2.2.42.6.22 1 .5 1.5 1 .5.5.78.9 1 1.5.17.4.37 1 .42 2.2.07 1.2.07 1.6.07 4.8s0 3.6-.07 4.8c-.05 1.2-.25 1.8-.42 2.2-.22.6-.5 1-1 1.5-.5.5-.9.78-1.5 1-.4.17-1 .37-2.2.42-1.2.07-1.6.07-4.8.07s-3.6 0-4.8-.07c-1.2-.05-1.8-.25-2.2-.42-.6-.22-1-.5-1.5-1-.5-.5-.78-.9-1-1.5-.17-.4-.37-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.8c.05-1.2.25-1.8.42-2.2.22-.6.5-1 1-1.5.5-.5.9-.78 1.5-1 .4-.17 1-.37 2.2-.42C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.2 0-3.5 0-4.7.07-1 .05-1.6.22-2 .37-.5.2-.85.42-1.2.78-.36.36-.58.7-.78 1.2-.15.4-.32 1-.37 2-.07 1.2-.07 1.5-.07 4.7s0 3.5.07 4.7c.05 1 .22 1.6.37 2 .2.5.42.85.78 1.2.36.36.7.58 1.2.78.4.15 1 .32 2 .37 1.2.07 1.5.07 4.7.07s3.5 0 4.7-.07c1-.05 1.6-.22 2-.37.5-.2.85-.42 1.2-.78.36-.36.58-.7.78-1.2.15-.4.32-1 .37-2 .07-1.2.07-1.5.07-4.7s0-3.5-.07-4.7c-.05-1-.22-1.6-.37-2-.2-.5-.42-.85-.78-1.2-.36-.36-.7-.58-1.2-.78-.4-.15-1-.32-2-.37-1.2-.07-1.5-.07-4.7-.07zm0 3.06A4.94 4.94 0 1 1 12 17a4.94 4.94 0 0 1 0-9.94zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28zm5.15-2.1a1.16 1.16 0 1 1 0 2.32 1.16 1.16 0 0 1 0-2.32z" />
          </svg>
        </a>
      </div>
    </div>
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-volt-500">Programs</h4>
      <ul class="mt-4 space-y-2 text-sm text-steel-300">
        <li><a href="/programs#build" class="hover:text-white">BUILD — AI tools</a></li>
        <li><a href="/programs#teach" class="hover:text-white">TEACH — AI literacy</a></li>
        <li><a href="/programs#defend" class="hover:text-white">DEFEND — Cybersecurity</a></li>
      </ul>
    </div>
    <div>
      <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-volt-500">Get involved</h4>
      <ul class="mt-4 space-y-2 text-sm text-steel-300">
        <li><a href="/start-here" class="hover:text-white">Start here</a></li>
        <li><a href="/donate" class="hover:text-white">Donate</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
        <li><a href="/about" class="hover:text-white">About</a></li>
        <li><a href="/prompts" class="hover:text-white">Prompts</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-steel-700/60">
    <div class="container-wide py-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-xs text-steel-400">
      <p>&copy; 2026 Blue Collar Labs. IRS-approved 501(c)(3) tax-exempt nonprofit.</p>
      <DnsBadge />
      <p><a href="/privacy" class="hover:text-white">Privacy</a> &middot; Built by tradesmen, for tradesmen.</p>
    </div>
  </div>
</footer>
