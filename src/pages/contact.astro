---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Contact — Blue Collar Labs">
  <section class="container-wide pt-20 pb-12">
    <p class="eyebrow">Contact</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-extrabold">Reach out.</h1>
    <p class="mt-6 max-w-2xl text-lg text-steel-300">
      Whether you're a contractor who wants to pilot a tool, a funder considering a grant, or a journalist covering the trades, we'd like to hear from you.
    </p>
  </section>

  <section class="container-wide py-8">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="card">
        <p class="eyebrow">For inquiries</p>
        <h3 class="mt-3 text-xl font-bold">Reach Paul directly</h3>
        <p class="mt-3 text-steel-300">Pilot interest, funder conversations, partnerships, speaking, or anything that needs a real human. Replies usually within one business day.</p>
        <a href="mailto:paul@bluecollarlabs.org" class="mt-5 inline-block btn-primary">paul@bluecollarlabs.org</a>
      </div>
      <div class="card">
        <p class="eyebrow">For requests</p>
        <h3 class="mt-3 text-xl font-bold">Media kit & support</h3>
        <p class="mt-3 text-steel-300">Press inquiries, media kit, logos, founder bio, fact sheets, or general help with anything we publish. Respond within one business day.</p>
        <a href="mailto:support@bluecollarlabs.org" class="mt-5 inline-block btn-primary">support@bluecollarlabs.org</a>
      </div>
    </div>
  </section>

  <section class="container-wide py-12">
    <div class="rounded-2xl border border-steel-700/60 bg-steel-800/40 p-8 md:p-10">
      <p class="eyebrow">Or send a message</p>
      <h2 class="mt-3 text-2xl font-bold">We read every one.</h2>
      <p class="mt-3 text-steel-300 max-w-2xl">Quickest way to reach us. Replies usually within one business day.</p>
      <form name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/thanks" class="mt-8 grid gap-5 md:grid-cols-2">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden"><label>Don't fill this out: <input name="bot-field" /></label></p>
        <label class="flex flex-col gap-2">
          <span class="text-sm text-steel-200 font-medium">Name</span>
          <input type="text" name="name" required class="rounded-md border border-steel-700 bg-steel-900/60 px-4 py-3 text-steel-100 placeholder:text-steel-500 focus:outline-none focus:ring-2 focus:ring-volt-500/60 focus:border-volt-500/60" placeholder="Jane Tradesperson" />
        </label>
        <label class="flex flex-col gap-2">
          <span class="text-sm text-steel-200 font-medium">Email</span>
          <input type="email" name="email" required class="rounded-md border border-steel-700 bg-steel-900/60 px-4 py-3 text-steel-100 placeholder:text-steel-500 focus:outline-none focus:ring-2 focus:ring-volt-500/60 focus:border-volt-500/60" placeholder="you@yourshop.com" />
        </label>
        <label class="flex flex-col gap-2 md:col-span-2">
          <span class="text-sm text-steel-200 font-medium">I'm reaching out about…</span>
          <select name="reason" class="rounded-md border border-steel-700 bg-steel-900/60 px-4 py-3 text-steel-100 focus:outline-none focus:ring-2 focus:ring-volt-500/60 focus:border-volt-500/60">
            <option>Pilot interest (contractor)</option>
            <option>Pitch deck / funder inquiry</option>
            <option>Press / media kit</option>
            <option>Partnership</option>
            <option>Workshop / training</option>
            <option>Other</option>
          </select>
        </label>
        <label class="flex flex-col gap-2 md:col-span-2">
          <span class="text-sm text-steel-200 font-medium">Message</span>
          <textarea name="message" required rows="5" class="rounded-md border border-steel-700 bg-steel-900/60 px-4 py-3 text-steel-100 placeholder:text-steel-500 focus:outline-none focus:ring-2 focus:ring-volt-500/60 focus:border-volt-500/60" placeholder="Tell us a bit about what you're trying to do."></textarea>
        </label>
        <div class="md:col-span-2">
          <button type="submit" class="btn-primary">Send message</button>
        </div>
      </form>
    </div>
  </section>
</Layout>
