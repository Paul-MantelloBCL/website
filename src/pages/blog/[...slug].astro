---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, pubDate, updatedDate, author, tags } = entry.data;
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout title={`${title} — Blue Collar Labs`} description={description}>
  <section class="container-wide pt-16 pb-6">
    <p class="text-sm text-steel-400">
      <a href="/blog" class="hover:text-volt-500">← All posts</a>
    </p>
    <p class="eyebrow mt-6">{fmt(pubDate)} · {author}</p>
    <h1 class="mt-3 text-3xl md:text-5xl font-extrabold">{title}</h1>
    <p class="mt-4 max-w-3xl text-lg text-steel-300">{description}</p>
    {updatedDate && <p class="mt-3 text-xs text-steel-500">Updated {fmt(updatedDate)}</p>}
    {tags.length > 0 && (
      <div class="mt-5 flex flex-wrap gap-1.5">
        {tags.map((t) => <span class="rounded-md bg-steel-800/80 px-2 py-1 text-xs text-steel-400">{t}</span>)}
      </div>
    )}
  </section>

  <section class="container-wide py-8">
    <article class="prose prose-invert max-w-3xl prose-headings:text-white prose-a:text-volt-500 prose-strong:text-white prose-code:text-volt-500">
      <Content />
    </article>
  </section>

  <section class="container-wide py-12">
    <div class="rounded-2xl border border-steel-700/60 bg-steel-800/40 p-8">
      <p class="eyebrow">Keep reading</p>
      <h2 class="mt-3 text-xl font-bold">More from the field</h2>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/blog" class="btn-secondary">All posts →</a>
        <a href="/prompts" class="btn-primary">Browse prompts</a>
      </div>
    </div>
  </section>
</Layout>
