---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout title="Blog — Blue Collar Labs" description="Field notes, pilot results, and rants from the working trades.">
  <section class="container-wide pt-20 pb-10">
    <p class="eyebrow">Blog</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-extrabold">Field notes from the trades.</h1>
    <p class="mt-6 max-w-2xl text-lg text-steel-300">
      Pilot results, lessons learned, and the occasional rant about clipboards. Written by the people doing the work.
    </p>
  </section>

  <section class="container-wide py-8">
    {posts.length === 0 ? (
      <div class="rounded-2xl border border-steel-700/60 bg-steel-800/40 p-10 text-center">
        <p class="eyebrow">Coming soon</p>
        <h2 class="mt-3 text-2xl font-bold">First post incoming.</h2>
        <p class="mt-3 text-steel-300">Subscribe on the homepage to get notified.</p>
      </div>
    ) : (
      <div class="grid gap-6 md:grid-cols-2">
        {posts.map((p) => (
          <a href={`/blog/${p.id}/`} class="card group flex flex-col">
            <p class="text-xs uppercase tracking-wider text-steel-400">{fmt(p.data.pubDate)} · {p.data.author}</p>
            <h3 class="mt-3 text-xl font-bold group-hover:text-volt-500">{p.data.title}</h3>
            <p class="mt-3 text-steel-300 flex-1">{p.data.description}</p>
            {p.data.tags.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-1.5">
                {p.data.tags.map((t) => (
                  <span class="rounded-md bg-steel-800/80 px-2 py-1 text-xs text-steel-400">{t}</span>
                ))}
              </div>
            )}
            <p class="mt-5 text-xs font-semibold uppercase tracking-wider text-steel-400 group-hover:text-volt-500">Read post →</p>
          </a>
        ))}
      </div>
    )}
  </section>
</Layout>
