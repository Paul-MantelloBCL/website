---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Blue Collar Labs">
  <section class="container-wide py-24 md:py-32">
    <p class="eyebrow">404 · Page not found</p>
    <h1 class="mt-3 text-5xl md:text-6xl font-extrabold">
      That wire's<br /><span class="text-volt-500">not in the panel.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-steel-300">
      The page you're looking for doesn't exist — maybe it was moved, maybe the link's stale. Either way, here's where to go next.
    </p>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 max-w-3xl">
      <a href="/" class="card hover:border-volt-500/60">
        <p class="eyebrow">Start here</p>
        <h3 class="mt-2 text-lg font-bold">Home</h3>
        <p class="mt-2 text-sm text-steel-300">The mission, in 30 seconds.</p>
      </a>
      <a href="/programs" class="card hover:border-volt-500/60">
        <p class="eyebrow">What we do</p>
        <h3 class="mt-2 text-lg font-bold">Programs</h3>
        <p class="mt-2 text-sm text-steel-300">Build · Teach · Defend.</p>
      </a>
      <a href="/donate" class="card hover:border-volt-500/60">
        <p class="eyebrow">Support the work</p>
        <h3 class="mt-2 text-lg font-bold">Donate</h3>
        <p class="mt-2 text-sm text-steel-300">$1 → $80–$160 in trade-worker value.</p>
      </a>
      <a href="/contact" class="card hover:border-volt-500/60">
        <p class="eyebrow">Reach out</p>
        <h3 class="mt-2 text-lg font-bold">Contact</h3>
        <p class="mt-2 text-sm text-steel-300">Pilot, partner, press, or just say hi.</p>
      </a>
    </div>
  </section>
</Layout>
