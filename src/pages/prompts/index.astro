---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('prompts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = ['estimating', 'customer', 'safety', 'admin', 'marketing', 'general'] as const;
const counts = Object.fromEntries(
  categories.map((c) => [c, all.filter((p) => p.data.category === c).length])
);
---
<Layout
  title="Prompts — Blue Collar Labs"
  description="A growing library of AI prompts for tradespeople. Copy, paste, get back to work."
>
  <section class="container-wide pt-20 pb-10">
    <p class="eyebrow">Prompts</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-extrabold">
      Copy. Paste.<br /><span class="text-volt-500">Get back to work.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-steel-300">
      A free library of battle-tested AI prompts written by tradesmen for tradesmen. Customer follow-ups, estimate prep, safety briefings, the boring admin stuff. Click copy, paste into ChatGPT or Claude, fill in the brackets.
    </p>
  </section>

  <section class="container-wide pb-4">
    <div class="flex flex-wrap gap-2">
      <a href="#all" class="rounded-full border border-steel-700 bg-steel-800/60 px-4 py-2 text-sm text-steel-200 hover:border-volt-500/60 hover:text-white">All ({all.length})</a>
      {categories.map((c) => counts[c] > 0 && (
        <a href={`#${c}`} class="rounded-full border border-steel-700 bg-steel-800/60 px-4 py-2 text-sm text-steel-200 hover:border-volt-500/60 hover:text-white capitalize">
          {c} ({counts[c]})
        </a>
      ))}
    </div>
  </section>

  <section id="all" class="container-wide py-8">
    {all.length === 0 ? (
      <div class="rounded-2xl border border-steel-700/60 bg-steel-800/40 p-10 text-center">
        <p class="eyebrow">Coming soon</p>
        <h2 class="mt-3 text-2xl font-bold">First prompts dropping shortly.</h2>
        <p class="mt-3 text-steel-300">Want to be notified? <a href="/contact" class="text-volt-500 underline-offset-4 hover:underline">Drop us a line.</a></p>
      </div>
    ) : (
      <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
        {all.map((p) => (
          <a href={`/prompts/${p.id}/`} class="card group flex flex-col">
            <p class="eyebrow capitalize">{p.data.category}</p>
            <h3 class="mt-3 text-lg font-bold group-hover:text-volt-500">{p.data.title}</h3>
            <p class="mt-3 text-sm text-steel-300 flex-1">{p.data.summary}</p>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {p.data.tags.slice(0, 3).map((t) => (
                <span class="rounded-md bg-steel-800/80 px-2 py-1 text-xs text-steel-400">{t}</span>
              ))}
            </div>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-steel-400 group-hover:text-volt-500">Open prompt →</p>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="container-wide py-12">
    <div class="rounded-2xl border border-volt-500/30 bg-volt-500/5 p-8 md:p-10">
      <p class="eyebrow">Got a prompt that saves you time?</p>
      <h2 class="mt-3 text-2xl font-bold">Send it in. We'll publish it (with credit).</h2>
      <p class="mt-3 text-steel-300 max-w-2xl">If you've got a prompt that consistently saves you a half-hour on Tuesday mornings, share it. Other tradesmen will use it. We'll attribute it to you and your shop.</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/contact" class="btn-primary">Submit a prompt</a>
      </div>
    </div>
  </section>
</Layout>
