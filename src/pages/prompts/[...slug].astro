---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const prompts = await getCollection('prompts', ({ data }) => !data.draft);
  return prompts.map((p) => ({ params: { slug: p.id }, props: { entry: p } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, category, tags, model, prompt, pubDate, updatedDate } = entry.data;
const dateStr = (updatedDate ?? pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---
<Layout title={`${title} — Prompts — Blue Collar Labs`} description={summary}>
  <section class="container-wide pt-16 pb-6">
    <p class="text-sm text-steel-400">
      <a href="/prompts" class="hover:text-volt-500">← All prompts</a>
    </p>
    <p class="eyebrow mt-6 capitalize">{category}</p>
    <h1 class="mt-3 text-3xl md:text-4xl font-extrabold">{title}</h1>
    <p class="mt-4 max-w-3xl text-steel-300">{summary}</p>
    <div class="mt-5 flex flex-wrap items-center gap-3 text-xs text-steel-400">
      <span>Updated {dateStr}</span>
      <span class="text-steel-600">·</span>
      <span>Works with {model}</span>
      {tags.length > 0 && (
        <>
          <span class="text-steel-600">·</span>
          <div class="flex flex-wrap gap-1.5">
            {tags.map((t) => <span class="rounded-md bg-steel-800/80 px-2 py-1">{t}</span>)}
          </div>
        </>
      )}
    </div>
  </section>

  <section class="container-wide py-6">
    <div class="rounded-2xl border border-steel-700/60 bg-steel-800/40 overflow-hidden">
      <div class="flex items-center justify-between gap-3 border-b border-steel-700/60 bg-steel-900/60 px-5 py-3">
        <p class="text-xs font-semibold uppercase tracking-wider text-volt-500">The prompt</p>
        <button
          type="button"
          data-copy-btn
          data-prompt-text={prompt}
          class="inline-flex items-center gap-2 rounded-md border border-volt-500/40 bg-volt-500/10 px-3 py-1.5 text-xs font-semibold text-volt-500 hover:bg-volt-500 hover:text-steel-900 transition"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" data-copy-icon>
            <path d="M7 3a2 2 0 00-2 2v8a2 2 0 002 2h6a2 2 0 002-2V7.414A2 2 0 0014.414 6L11 2.586A2 2 0 009.586 2H7zm5 0v3a1 1 0 001 1h3" />
            <path d="M3 7a2 2 0 012-2v9a3 3 0 003 3h7a2 2 0 01-2 2H8a5 5 0 01-5-5V7z" />
          </svg>
          <span data-copy-label>Copy prompt</span>
        </button>
      </div>
      <pre class="overflow-x-auto p-5 md:p-6 text-sm text-steel-100 whitespace-pre-wrap break-words font-mono leading-relaxed">{prompt}</pre>
    </div>
  </section>

  <section class="container-wide py-8">
    <article class="prose prose-invert max-w-3xl prose-headings:text-white prose-a:text-volt-500 prose-strong:text-white">
      <Content />
    </article>
  </section>

  <section class="container-wide py-12">
    <div class="rounded-2xl border border-steel-700/60 bg-steel-800/40 p-8">
      <p class="eyebrow">Got a better version?</p>
      <h2 class="mt-3 text-xl font-bold">Send it in — we'll publish improvements.</h2>
      <p class="mt-3 text-steel-300 max-w-2xl">If you tweak this prompt and get sharper results, share what you changed. Good edits get credited.</p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a href="/contact" class="btn-primary">Submit an improvement</a>
        <a href="/prompts" class="btn-secondary">More prompts →</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  const copiedLabel = 'Copied!';
  document.querySelectorAll<HTMLButtonElement>('[data-copy-btn]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.promptText ?? '';
      const labelEl = btn.querySelector<HTMLElement>('[data-copy-label]');
      const original = labelEl?.textContent ?? 'Copy prompt';
      try {
        await navigator.clipboard.writeText(text);
        if (labelEl) labelEl.textContent = copiedLabel;
        btn.classList.add('!bg-volt-500', '!text-steel-900');
      } catch {
        if (labelEl) labelEl.textContent = 'Press Ctrl+C';
      }
      setTimeout(() => {
        if (labelEl) labelEl.textContent = original;
        btn.classList.remove('!bg-volt-500', '!text-steel-900');
      }, 1800);
    });
  });
</script>
