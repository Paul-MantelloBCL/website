---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Thanks — Blue Collar Labs">
  <section class="container-wide py-24 md:py-32">
    <p class="eyebrow">Thanks</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-extrabold">Message received.</h1>
    <p class="mt-6 max-w-2xl text-lg text-steel-300">
      We read every submission. Most replies go out within one business day. If it's urgent, hit
      <a href="mailto:support@bluecollarlabs.org" class="text-volt-500 underline-offset-4 hover:underline">support@bluecollarlabs.org</a>
      directly.
    </p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">Back to home</a>
      <a href="/programs" class="btn-secondary">See programs →</a>
    </div>
  </section>
</Layout>
