---
import Layout from '../layouts/Layout.astro';

// Suggested-amount tiles. Each amount maps to one concrete impact line so the
// donor knows exactly what their dollars unlock — same audit-request playbook,
// donor-funnel edition.
const tiers = [
  { amount: 25, blurb: 'Funds one apprentice\'s seat in a Founding-25 cohort week.' },
  { amount: 100, blurb: 'Funds one shop\'s free phishing audit — including the anonymized case-study debrief.' },
  { amount: 500, blurb: 'Funds the full audit + published case-study debrief for one small trade shop.' },
  { amount: 2500, blurb: 'Subsidizes a full pilot deployment of a BUILD tool to one shop.' },
];

// Year-1 dollars breakdown. Source: about-page Year-1 plan + the funding tiers
// below. Ratios reflect the spirit of 501(c)(3) disclosure: most dollars hit
// program work, ops stays lean.
const year1Mix = [
  { label: 'Programs (BUILD · TEACH · DEFEND)', pct: 83, body: '$250k of every $300k catalytic round goes directly to the three pillars — engineering, instruction, and audit work.' },
  { label: 'Operations (ops · compliance · governance)', pct: 17, body: '$50k pilot block covers compliance, governance, and the lean staffing it takes to keep a new 501(c)(3) audit-ready.' },
];

const pillars = [
  { name: 'Pilot', amount: '$50k', alloc: 'Ops', body: "Funds operations, compliance, and early staff for one quarter. Gets the nonprofit out of the founder's pocket and onto firm ground." },
  { name: 'Build', amount: '$75k', alloc: 'BUILD', body: 'Engineering + deployment of the Truck Inventory and AI Estimator tools to the first 50 pilot contractors.' },
  { name: 'Teach', amount: '$100k', alloc: 'TEACH', body: 'Instructional design, workshop production, and free-tier subsidy for the AI-Ready Tradesman certificate.' },
  { name: 'Defend', amount: '$75k', alloc: 'DEFEND', body: "Audit tooling, certs, and free-tier subsidy for shops that can't afford a proper security review." },
];
---
<Layout
  title="Donate — Blue Collar Labs"
  description="Fund a pillar — Build, Teach, or Defend. 501(c)(3) tax-deductible, EIN 42-1853577. Every dollar tracked against measurable outcomes."
  ogImage="/og/donate.png"
>
  <section class="container-wide pt-20 pb-12">
    <p class="eyebrow">Donate</p>
    <h1 class="mt-3 text-4xl md:text-5xl font-extrabold">
      Fund a pillar.<br /><span class="text-volt-500">Fund the trades.</span>
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-steel-300">
      We're seeking catalytic grants of $50k–$300k to scale our newly-approved 501(c)(3) — serving 10 million underserved workers. Every dollar is tracked against measurable outcomes: tools deployed, tradespeople certified, shops hardened.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="https://donorbox.org/bluecollar-labs" target="_blank" rel="noopener" class="btn-primary !py-3.5 !px-6 text-base">Donate now →</a>
      <a href="/contact" class="btn-secondary">Talk to us first</a>
    </div>
  </section>

  <section class="container-wide py-4">
    <details class="group rounded-2xl border border-steel-700/60 bg-steel-800/40 p-6 md:p-8">
      <summary class="cursor-pointer list-none flex items-center justify-between gap-3">
        <div>
          <p class="eyebrow">Trust · is this legit?</p>
          <h2 class="mt-2 text-xl font-bold">IRS-approved 501(c)(3), EIN <span class="font-mono text-volt-500">42-1853577</span>. Audited in public.</h2>
        </div>
        <span aria-hidden="true" class="text-volt-500 transition-transform group-open:rotate-45">+</span>
      </summary>
      <div class="mt-5 grid gap-4 text-sm text-steel-300 md:grid-cols-2">
        <div>
          <p class="text-xs uppercase tracking-wider text-volt-500">Tax-deductible</p>
          <p class="mt-2">501(c)(3) public-charity determination from the IRS, approved April 2026. Every gift — one-time or recurring — is fully tax-deductible in the United States. Receipts issued automatically through Donorbox.</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-volt-500">Federal EIN</p>
          <p class="mt-2"><span class="font-mono text-steel-100">42-1853577</span>. Searchable on the IRS Tax Exempt Organization Search. Verify before you give — same EIN appears in our footer site-wide and on every receipt.</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-volt-500">Audited in public</p>
          <p class="mt-2">DNS posture, governance, and self-audit scorecard live at <a href="/trust" class="text-volt-500 underline-offset-4 hover:underline">/trust</a>. Same five-control rubric we run on the shops we audit gets run on us first.</p>
        </div>
        <div>
          <p class="text-xs uppercase tracking-wider text-volt-500">Refunds + governance</p>
          <p class="mt-2">Donation refunds honored within 30 days, no questions. Governance practices documented under <a href="/privacy" class="text-volt-500 underline-offset-4 hover:underline">/privacy</a>. Questions on either — <a href="/contact" class="text-volt-500 underline-offset-4 hover:underline">contact us</a> before you give.</p>
        </div>
      </div>
    </details>
  </section>

  <section class="container-wide py-8">
    <div class="rounded-2xl border border-steel-700/60 bg-steel-800/40 p-8 md:p-10">
      <p class="eyebrow">Quick give</p>
      <h2 class="mt-3 text-2xl font-bold">Pick an amount, pick an outcome.</h2>
      <p class="mt-3 text-steel-300 max-w-2xl">Every tile maps to one concrete impact line. Click an amount to open the donation page pre-filled — tax-deductible receipt issued automatically.</p>
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {tiers.map((t) => (
          <a href={`https://donorbox.org/bluecollar-labs?amount=${t.amount}`} target="_blank" rel="noopener" class="group rounded-xl border border-steel-700/60 bg-steel-900/40 p-5 transition hover:border-volt-500/60 hover:bg-steel-900/70">
            <div class="text-3xl font-extrabold text-volt-500">${t.amount}</div>
            <p class="mt-3 text-sm text-steel-300">{t.blurb}</p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-wider text-steel-400 group-hover:text-volt-500">Give →</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="container-wide py-8">
    <div class="rounded-2xl border border-steel-700/60 bg-steel-800/40 p-8 md:p-10">
      <p class="eyebrow">Where Year-1 dollars go</p>
      <h2 class="mt-3 text-2xl font-bold">Most of every dollar lands on program work.</h2>
      <p class="mt-3 text-steel-300 max-w-2xl">Required disclosure for a 501(c)(3) — and how we think about it ourselves. Ratios assume the full $300k catalytic round; smaller gifts roll into the same mix proportionally.</p>
      <div class="mt-6 space-y-5">
        {year1Mix.map((m) => (
          <div>
            <div class="flex items-baseline justify-between gap-3">
              <p class="text-sm font-semibold text-steel-100">{m.label}</p>
              <p class="text-sm font-mono text-volt-500">{m.pct}%</p>
            </div>
            <div class="mt-2 h-2 w-full overflow-hidden rounded-full bg-steel-700/60">
              <div class="h-full bg-volt-500 transition-all duration-500" style={`width: ${m.pct}%`}></div>
            </div>
            <p class="mt-2 text-xs text-steel-400">{m.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="container-wide py-8">
    <div class="rounded-2xl border border-volt-500/30 bg-gradient-to-br from-volt-500/10 to-transparent p-8 md:p-10">
      <p class="eyebrow">SROI</p>
      <h2 class="mt-3 text-3xl font-bold">$1 donated → $80–$160 in tradesperson value</h2>
      <p class="mt-4 max-w-3xl text-steel-300">Tools save hours. Training wins jobs. Audits stop losses. Measured in aggregate across our three-year target: 2,500 tool users, 5,000 certified tradespeople, 250 hardened shops.</p>
    </div>
  </section>

  <section class="container-wide py-12">
    <p class="eyebrow">Funding tiers</p>
    <h2 class="mt-3 text-3xl font-bold">Where the money goes</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {pillars.map((p) => (
        <div class="card">
          <div class="flex items-baseline justify-between">
            <h3 class="text-xl font-bold">{p.name}</h3>
            <span class="text-2xl font-extrabold text-volt-500">{p.amount}</span>
          </div>
          <p class="mt-2 text-xs uppercase tracking-wider text-steel-400">Allocation: {p.alloc}</p>
          <p class="mt-4 text-steel-300">{p.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="container-wide py-12">
    <div class="rounded-2xl border border-steel-700/60 bg-steel-800/40 p-8 md:p-10">
      <p class="eyebrow">Ways to give</p>
      <h2 class="mt-3 text-2xl font-bold">Grants, gifts, and partnerships</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3 text-sm text-steel-200">
        <div class="rounded-lg border border-steel-700/60 bg-steel-900/40 p-5">
          <strong class="text-white">Grants</strong><br />
          <span class="text-steel-300">Foundations and corporate funders — we maintain a rolling pipeline (OpenAI People-First AI, IBM Impact, Google.org, NSF SBIR).</span>
        </div>
        <div class="rounded-lg border border-steel-700/60 bg-steel-900/40 p-5">
          <strong class="text-white">Individual gifts</strong><br />
          <span class="text-steel-300">One-time or recurring. <strong class="text-white">Fully tax-deductible</strong> — 501(c)(3) determination approved April 2026.</span>
        </div>
        <div class="rounded-lg border border-steel-700/60 bg-steel-900/40 p-5">
          <strong class="text-white">Partnerships</strong><br />
          <span class="text-steel-300">Supplier co-funding, CSR programs, trade-association sponsorships.</span>
        </div>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/contact" class="btn-primary">Request the pitch deck</a>
        <a href="/contact" class="btn-secondary">Schedule a call</a>
      </div>
    </div>
  </section>
</Layout>
