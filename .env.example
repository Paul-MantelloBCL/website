# Required env vars for the waitlist function.
# Real values live in Netlify dashboard (production) and a local untracked .env file (dev).

# Notion internal-integration token (must have access to BOTH databases below)
NOTION_TOKEN=

# Notion database id for school waitlist signups
NOTION_SCHOOL_DB_ID=

# Notion database id for newsletter signups
NOTION_NEWSLETTER_DB_ID=
